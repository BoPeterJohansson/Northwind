model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-AU
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Categories","Customers","Employees","EmployeeTerritories","Orders","Order Details","Products","Region","Shippers","Suppliers","Territories","Calendar"]

annotation PBI_ProTooling = ["DevMode"]

ref table Orders
ref table Categories
ref table Customers
ref table Employees
ref table EmployeeTerritories
ref table 'Order Details'
ref table Products
ref table Region
ref table Shippers
ref table Suppliers
ref table Territories
ref table Calendar

ref cultureInfo en-US

