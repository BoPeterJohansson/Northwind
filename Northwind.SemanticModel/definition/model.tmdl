model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-AU
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Categories","Customers","Employees","EmployeeTerritories","Orders","Order Details","Products","Region","Shippers","Suppliers","Territories"]

annotation PBI_ProTooling = ["DevMode"]

ref table Categories
ref table Products
ref table Suppliers
ref table Orders
ref table 'Order Details'
ref table Shippers
ref table Employees
ref table Customers
ref table EmployeeTerritories
ref table Region
ref table Territories

ref cultureInfo en-US

